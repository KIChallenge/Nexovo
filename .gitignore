# SV-Box-Daten sind laut Teilnahmeinfo S. 2 frei verteilbar; für die Ausführung nötige Ordner liegen im Repo.
# Nicht im Repo: Befunde (realistische Personendaten), Use-Case-DOCX (enthält SV-Box-Zugang),
# API-Beispiel-DOCX (interner Endpoint), Teilnahmeinfo sowie das Inventar mit Befund-Dateinamen.
/Befunde/
/*.pdf
/*.docx
/Analyse/Dokumenteninventar.csv

# Geheimnisse und lokale Konfiguration
.env
.env.*
!.env.example

# Lokale Umgebung
.directory
.venv/
__pycache__/
.cache/
.pytest_cache/

# Editor-Swap- und Backupdateien (können ungespeicherte Schlüssel enthalten)
*.kate-swp
*.swp
*~
# Lokale Notizen mit Zugangsdaten
mazure.txt
